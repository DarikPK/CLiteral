<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PdfPreviewFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:layout_below="@id/appbar">

        <ImageButton
            android:id="@+id/previous_page_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Página Anterior"
            style="?android:attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/page_number_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            tools:text="Página 1 / 10" />

        <ImageButton
            android:id="@+id/next_page_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Página Siguiente"
            style="?android:attr/borderlessButtonStyle"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/navigation_bar">

        <com.example.imageextractor.ZoomableImageView
            android:id="@+id/pdf_page_zoomable_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CCCCCC" />

        <com.example.imageextractor.StampOverlayView
            android:id="@+id/stamp_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.imageextractor.StampOverlayView
            android:id="@+id/stamp2_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.imageextractor.StampOverlayView
            android:id="@+id/signature_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</RelativeLayout>
