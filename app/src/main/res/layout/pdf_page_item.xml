<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.imageextractor.ZoomableImageView
                android:id="@+id/page_image_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Página del PDF"
                tools:src="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/stamp_image_view"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:visibility="gone"
                tools:src="@android:drawable/ic_menu_myplaces"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/page_number_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:textAppearance="?attr/textAppearanceCaption"
            tools:text="Página 1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
