<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Efectos de Realismo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Intensidad de Arrugas"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_wrinkles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="30"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Desgaste de Tinta"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_ink_wear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="20"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Amarilleo del Papel"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_aging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="15"/>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sombra de Complexión"
        android:checked="true"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btn_apply_effects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplicar Efectos"
        android:layout_marginTop="24dp"/>

</LinearLayout>