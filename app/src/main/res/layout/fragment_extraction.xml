<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ExtractionFragment">

    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Right-aligned action buttons -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="Acción"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/debug_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:fabSize="mini"
        android:src="@android:drawable/ic_menu_view"
        android:contentDescription="Mostrar Panel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action_button" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/extract_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_search"
        android:contentDescription="Extraer Imágenes"
        app:layout_constraintBottom_toTopOf="@id/action_button"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- Left-aligned navigation controls group -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_go_to_first_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:fabSize="mini"
        android:src="@android:drawable/ic_media_rew"
        android:contentDescription="Ir al primer elemento (más antiguo)"
        app:backgroundTint="@color/fab_state_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        tools:visibility="visible"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_previous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:fabSize="mini"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Anterior"
        app:backgroundTint="@color/fab_state_color"
        app:layout_constraintBottom_toBottomOf="@id/fab_go_to_first_item"
        app:layout_constraintStart_toEndOf="@id/fab_go_to_first_item"
        android:visibility="gone"
        tools:visibility="visible"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:fabSize="mini"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="Siguiente"
        app:backgroundTint="@color/fab_state_color"
        app:layout_constraintBottom_toBottomOf="@id/fab_previous"
        app:layout_constraintStart_toEndOf="@id/fab_previous"
        android:visibility="gone"
        tools:visibility="visible"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_go_to_last_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:fabSize="mini"
        android:src="@android:drawable/ic_media_ff"
        android:contentDescription="Ir al último elemento (más reciente)"
        app:backgroundTint="@color/fab_state_color"
        app:layout_constraintBottom_toBottomOf="@id/fab_next"
        app:layout_constraintStart_toEndOf="@id/fab_next"
        android:visibility="gone"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>